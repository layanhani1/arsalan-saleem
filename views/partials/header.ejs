<header class="site-header">
    <div class="header-inner">

        <a href="/" class="brand" aria-label="Arsalan Al-saleem — Home">
            <span class="brand-mark" aria-hidden="true">A.</span>

            <span class="brand-name">
                <span>ARSALAN</span>
                <span>AL-SALEEM</span>
            </span>
        </a>

        <nav class="main-nav" id="main-navigation"
             aria-label="Main navigation">

            <a href="/"
               class="nav-link <%= currentPath === '/' ? 'active' : '' %>"
               <%= currentPath === '/' ? 'aria-current="page"' : '' %>>
                Home
            </a>

            <a href="/petra"
               class="nav-link <%= currentPath === '/petra' ? 'active' : '' %>"
               <%= currentPath === '/petra' ? 'aria-current="page"' : '' %>>
                Petra
            </a>

            <a href="/jordan"
               class="nav-link <%= currentPath === '/jordan' ? 'active' : '' %>"
               <%= currentPath === '/jordan' ? 'aria-current="page"' : '' %>>
                Around Jordan
            </a>

            <a href="/recommendations"
               class="nav-link <%= currentPath === '/recommendations' ? 'active' : '' %>"
               <%= currentPath === '/recommendations' ? 'aria-current="page"' : '' %>>
                Reviews
            </a>

            <a href="/visitor-guide"
               class="nav-link <%= currentPath === '/visitor-guide' ? 'active' : '' %>"
               <%= currentPath === '/visitor-guide' ? 'aria-current="page"' : '' %>>
                Travel smart
            </a>

            <a href="/contact"
               class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>"
               <%= currentPath === '/contact' ? 'aria-current="page"' : '' %>>
                Get in touch
            </a>

        </nav>

        <button
            class="menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="main-navigation">

            <span class="menu-toggle-text">Menu</span>

            <span class="menu-icon" aria-hidden="true">
                <span></span>
                <span></span>
            </span>
        </button>

    </div>
</header>