<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Login | Arsalan Al-Saleem</title>

  <style>
    :root {
      --cambridge-blue: #A1B5A8;
      --khaki: #CBB093;
      --fawn: #DFA477;
      --redwood: #A4624D;
      --almond: #F5DFC5;
      --dark: #34382F;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background: var(--almond);
      color: var(--dark);
      font-family: Arial, sans-serif;
    }

    .login-card {
      width: 100%;
      max-width: 420px;
      padding: 40px;
      border-radius: 20px;
      background: #fffaf3;
      box-shadow: 0 16px 50px rgba(52, 56, 47, 0.12);
    }

    .eyebrow {
      color: var(--redwood);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    h1 {
      margin: 14px 0 10px;
      font-family: Georgia, serif;
      font-size: 34px;
    }

    .description {
      color: #77776d;
      line-height: 1.7;
      font-size: 14px;
    }

    label {
      display: block;
      margin: 20px 0 8px;
      font-size: 13px;
      font-weight: 700;
    }

    input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #ddd1c0;
      border-radius: 9px;
      background: white;
      font-size: 15px;
    }

    input:focus {
      outline: 2px solid var(--cambridge-blue);
      border-color: transparent;
    }

    button {
      width: 100%;
      margin-top: 25px;
      padding: 14px;
      border: none;
      border-radius: 9px;
      background: var(--redwood);
      color: white;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    button:hover {
      background: #874c3b;
    }

    .error {
      margin-top: 18px;
      padding: 12px;
      border-radius: 8px;
      background: #f8e7e3;
      color: #8b3326;
      font-size: 13px;
      line-height: 1.6;
    }

    .footer-note {
      margin-top: 24px;
      text-align: center;
      color: #858174;
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .login-card {
        padding: 28px 22px;
      }
    }
  </style>
</head>

<body>
  <main class="login-card">
    <div class="eyebrow">Private Access</div>

    <h1>Welcome back.</h1>

    <p class="description">
      Sign in to manage visitor recommendations and review submissions.
    </p>

    <form action="/admin/login" method="POST">
      <label for="username">Username</label>

      <input
        id="username"
        name="username"
        type="text"
        autocomplete="username"
        required
      >

      <label for="password">Password</label>

      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      >

      <button type="submit">Sign In</button>
    </form>

    <% if (error) { %>
      <div class="error" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="footer-note">
      Authorized access only · Arsalan Al-saleem
    </div>
  </main>
</body>
</html>