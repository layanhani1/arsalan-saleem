<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
     
<main class="contact-page">

  <!-- Hero -->
  <section class="contact-hero">
    <span class="contact-eyebrow">LET'S CONNECT</span>

    <h1>Get in touch.<br><em>Let's plan your journey.</em></h1>

    <p>
      Have a question or planning a trip to Jordan?
      I'd love to hear from you.
    </p>
  </section>


  <!-- Contact Options -->
  <section class="contact-options">

    <a
      class="contact-card contact-instagram"
      href="https://www.instagram.com/arsalan__saleem/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact Arsalan on Instagram"
    >
      <span class="contact-icon contact-icon-instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"
                fill="none" stroke="currentColor" stroke-width="2"/>
          <circle cx="12" cy="12" r="4"
                  fill="none" stroke="currentColor" stroke-width="2"/>
          <circle cx="17.5" cy="6.8" r="1.2" fill="currentColor"/>
        </svg>
      </span>

      <span class="contact-card-text">
        <span class="contact-label">FOLLOW & MESSAGE</span>
        <strong>Instagram</strong>
        <span class="contact-description">
          Let's connect and share inspiration.
        </span>
      </span>

      <span class="contact-arrow" aria-hidden="true">↗</span>
    </a>


    <a
      class="contact-card contact-whatsapp"
      href="https://wa.me/962777915333"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact Arsalan on WhatsApp"
    >
      <span class="contact-icon contact-icon-whatsapp">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.4-4.9a8.4 8.4 0 1 1 16.1-3.9Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="M8.5 7.8c.3-.6.6-.6 1-.6h.4c.2 0 .4.1.5.4l.8 1.8c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.1.6-.1l.8-1c.2-.2.4-.2.6-.1l1.8.9c.2.1.3.3.3.5 0 .5-.2 1.1-.6 1.4-.5.5-1.2.7-1.9.5-1.2-.3-2.5-1-3.8-2.2-1.1-1.1-1.9-2.4-2.2-3.6-.2-.7 0-1.4.3-1.9Z"
            fill="currentColor"
          />
        </svg>
      </span>

      <span class="contact-card-text">
        <span class="contact-label">QUICK & EASY</span>
        <strong>WhatsApp</strong>
        <span class="contact-description">
          Ask a question or discuss your plans.
        </span>
      </span>

      <span class="contact-arrow" aria-hidden="true">↗</span>
    </a>


    <a
      class="contact-card contact-email"
      href="mailto:re.saleem@yahoo.com"
      aria-label="Send Arsalan an email"
    >
      <span class="contact-icon contact-icon-email">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"
                fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="m4 7 8 6 8-6"
                fill="none" stroke="currentColor" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <span class="contact-card-text">
        <span class="contact-label">BUSINESS INQUIRIES</span>
        <strong>Email</strong>
        <span class="contact-description">
          Send a message about your trip or collaboration.
        </span>
      </span>

      <span class="contact-arrow" aria-hidden="true">↗</span>
    </a>

  </section>


  <!-- Closing Message -->
  <section class="contact-note">
    <span class="contact-note-line"></span>
    <p>Every great journey starts with a conversation.</p>
    <span class="contact-note-line"></span>
  </section>

</main>

    


        <%- include('partials/footer') %>
    <script src="/js/main.js" defer></script>
</body>
</html>